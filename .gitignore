# Xcode (project is generated by xcodegen)
*.xcodeproj/
xcuserdata/
DerivedData/
*.xcresult

# SwiftPM
.build/
.swiftpm/
Package.resolved
# Where CI (and anyone passing -clonedSourcePackagesDirPath) puts resolved
# packages, including Sparkle's binary xcframework and its command-line tools.
SourcePackages/

# macOS
.DS_Store

# Fetched by Scripts/fetch-models.sh, not committed (~93 MB)
Cheerio/Resources/Models/

# Local xcodebuild output (release.yml builds into build/ via -derivedDataPath;
# a stray local build once nearly swept ~400MB of derived data into a commit).
build/

# Screenshot harness output (regenerate with Scripts/screenshots/capture.sh)
Scripts/screenshots/out/
