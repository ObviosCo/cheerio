<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Cheerio</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>Cheerio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Dev placeholder, not a real version — releases are CalVer YY.MM.BUILD
	     (see .github/workflows/release.yml), and 0.0.0 can't collide with one.
	     Overwritten on every CI run: tags set it to the tag's own version;
	     manual (workflow_dispatch) runs leave whatever is already here. -->
	<key>CFBundleShortVersionString</key>
	<string>0.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Cheerio captures system audio so it can transcribe the other participants in your meetings. Nothing leaves this Mac.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Cheerio reads your calendar to suggest recording when a meeting starts and to attach notes to events.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Cheerio records your side of meetings so it can transcribe them on-device.</string>
	<key>SUAutomaticallyUpdate</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableSystemProfiling</key>
	<false/>
	<key>SUFeedURL</key>
	<string>https://github.com/ObviosCo/cheerio/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>eACjTQLCaS85Qi+Y5eN6ovaeDDMD4xBRmiHHDQCmRqw=</string>
</dict>
</plist>
