<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox is OFF, and must stay off. It is what makes Core Audio process
         taps deliver silence: a sandboxed build creates the tap with noErr at every
         step and then reads all zeroes, with no TCC prompt and no error anywhere.
         Measured on identical code: peak=0.0 sandboxed vs -1.8 dBFS unsandboxed.
         This rules out Mac App Store distribution. Hardened runtime stays on.
         Note the data location moves with this flag: sandboxed builds live under
         ~/Library/Containers/app.cheerio.mac/Data/, unsandboxed under ~/Library.
         Also required by Hardened Runtime for microphone access: -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
